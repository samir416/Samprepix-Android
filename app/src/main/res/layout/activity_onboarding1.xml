<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="42dp"
                android:layout_height="4dp"
                android:background="@color/primary" />

            <View
                android:layout_width="22dp"
                android:layout_height="4dp"
                android:layout_marginStart="6dp"
                android:background="@color/card_dark" />

            <View
                android:layout_width="22dp"
                android:layout_height="4dp"
                android:layout_marginStart="6dp"
                android:background="@color/card_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="Step 1 of 3"
                android:textColor="@color/text_dark"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_skip"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Skip"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar"
        android:layout_above="@id/btn_next"
        android:orientation="vertical"
        android:paddingTop="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="What's your target role?"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Choose what you want to prepare for"
            android:textColor="@color/text_dark"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/role_frontend"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="@color/primary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Frontend Developer"
                android:textColor="@color/text"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/role_fullstack"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="@color/primary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Full Stack Developer"
                android:textColor="@color/text"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/role_backend"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="@color/primary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Backend Developer"
                android:textColor="@color/text"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/role_mobile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="@color/purple"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Mobile App Developer"
                android:textColor="@color/text"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/role_data"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="@color/purple"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Data Analyst"
                android:textColor="@color/text"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/role_other"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="@color/amber"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Other"
                android:textColor="@color/text"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/btn_bg"
        android:gravity="center"
        android:text="Next →"
        android:textAllCaps="false"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:textStyle="bold" />

</RelativeLayout>